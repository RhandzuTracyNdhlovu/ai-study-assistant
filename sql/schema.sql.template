-- Draft only. Replace <N> with the length of one returned Workers AI embedding array.
-- Do not execute until N is measured and the draft is reviewed.
CREATE TABLE documents (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    filename text NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE chunks (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    document_id uuid NOT NULL,
    page_number integer NOT NULL CHECK (page_number >= 1),
    chunk_index integer NOT NULL CHECK (chunk_index >= 0),
    text text NOT NULL,
    embedding vector(<N>),
    CONSTRAINT chunks_document_fk
        FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE,
    CONSTRAINT chunks_page_chunk_unique
        UNIQUE (document_id, page_number, chunk_index)
);
